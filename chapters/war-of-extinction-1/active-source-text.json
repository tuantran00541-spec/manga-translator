    "global_x1": 12,
    "ocr_text": "WHOSE CREATION...",
    "semantic_type": "text"
  },
  {
    "page_index": 41,
    "source_page": 11,
    "slice_index": 5,
    "object_id": "text_75518add9f524cd2",
    "box_id": "box_75518add9f524cd2",
    "global_y1": 14364,
    "global_x1": 2,
    "ocr_text": "WOULD PROVE\nSUPERIOR TO ALL\nOTHERS?",
    "semantic_type": "free_text"
  },
  {
    "page_index": 43,
    "source_page": 13,
    "slice_index": 0,
    "object_id": "text_ccbcd3971e364ac6",
    "box_id": "box_ccbcd3971e364ac6",
    "global_y1": 179,
    "global_x1": 76,
    "ocr_text": "BWAHAHAHA!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 43,
    "source_page": 13,
    "slice_index": 0,
    "object_id": "text_749f6671d5064e48",
    "box_id": "box_749f6671d5064e48",
    "global_y1": 2534,
    "global_x1": 134,
    "ocr_text": "I LIKE IT!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 44,
    "source_page": 13,
    "slice_index": 1,
    "object_id": "text_19556be06ec545bf",
    "box_id": "box_19556be06ec545bf",
    "global_y1": 3540,
    "global_x1": 324,
    "ocr_text": "I WILL\nPARTICIPATE.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 44,
    "source_page": 13,
    "slice_index": 1,
    "object_id": "text_bd501f315d8b4fd3",
    "box_id": "box_bd501f315d8b4fd3",
    "global_y1": 5369,
    "global_x1": 149,
    "ocr_text": "ANY WORLD THAT\nLACKS CONFIDENCE\nCAN SIT THIS OUT.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 45,
    "source_page": 13,
    "slice_index": 2,
    "object_id": "text_5704be0bc89e4370",
    "box_id": "box_5704be0bc89e4370",
    "global_y1": 6278,
    "global_x1": 30,
    "ocr_text": "THE RESULT:\nUNANIMOUS APPROVAL.",
    "semantic_type": "free_text"
  },
  {
    "page_index": 47,
    "source_page": 13,
    "slice_index": 4,
    "object_id": "text_01090bfbdc8d4016",
    "box_id": "box_01090bfbdc8d4016",
    "global_y1": 10043,
    "global_x1": 205,
    "ocr_text": "IT'S DECIDED,\nTHEN. IN THAT\nCASE...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 48,
    "source_page": 13,
    "slice_index": 5,
    "object_id": "text_3eb0ae1a9fb4488e",
    "box_id": "box_3eb0ae1a9fb4488e",
    "global_y1": 12103,
    "global_x1": 139,
    "ocr_text": "THE TOURNAMENT\nOF THE WORLDS'\nSTRONGEST",
    "semantic_type": "text"
  },
  {
    "page_index": 49,
    "source_page": 13,
    "slice_index": 6,
    "object_id": "text_95f796481f2d4a0e",
    "box_id": "box_95f796481f2d4a0e",
    "global_y1": 14819,
    "global_x1": 150,
    "ocr_text": "SHALL BE HELD!!",
    "semantic_type": "free_text"
  },
  {
    "page_index": 50,
    "source_page": 14,
    "slice_index": 0,
    "object_id": "text_924d7e0d76c6445b",
    "box_id": "box_924d7e0d76c6445b",
    "global_y1": 2855,
    "global_x1": 10,
    "ocr_text": "THE PRESENT",
    "semantic_type": "text"
  },
  {
    "page_index": 51,
    "source_page": 15,
    "slice_index": 0,
    "object_id": "text_d0ec656084194005",
    "box_id": "box_d0ec656084194005",
    "global_y1": 187,
    "global_x1": 92,
    "ocr_text": "STRANGE.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 51,
    "source_page": 15,
    "slice_index": 0,
    "object_id": "text_31b4668ad79c4f44",
    "box_id": "box_31b4668ad79c4f44",
    "global_y1": 1194,
    "global_x1": 454,
    "ocr_text": "WHAT IS?",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 52,
    "source_page": 15,
    "slice_index": 1,
    "object_id": "text_cbc4128af13141ba",
    "box_id": "box_cbc4128af13141ba",
    "global_y1": 1797,
    "global_x1": 160,
    "ocr_text": "I SENSE\nPOWERFUL ENERGY\nFROM ALL OF THEM,\nBUT NOTHING FROM\nTHAT ONE.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 52,
    "source_page": 15,
    "slice_index": 1,
    "object_id": "text_aee41808b6be4149",
    "box_id": "box_aee41808b6be4149",
    "global_y1": 3500,
    "global_x1": 322,
    "ocr_text": "WORLD 9\n<MUTANT REPRESENTATIVE>\nULTRA BYTE",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 53,
    "source_page": 15,
    "slice_index": 2,
    "object_id": "text_d27343bc57e240f2",
    "box_id": "box_d27343bc57e240f2",
    "global_y1": 4426,
    "global_x1": 176,
    "ocr_text": "WHO'S THAT\nPATHETIC-LOOKING\nWRETCH?",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 54,
    "source_page": 15,
    "slice_index": 3,
    "object_id": "text_19468e82a60b45ac",
    "box_id": "box_19468e82a60b45ac",
    "global_y1": 6962,
    "global_x1": 65,
    "ocr_text": "WORLD 9\n<ORDINARY WORLD\nREPRESENTATIVE>\nSHIN JAHYEON",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 55,
    "source_page": 15,
    "slice_index": 4,
    "object_id": "text_93aa086ba605490a",
    "box_id": "box_93aa086ba605490a",
    "global_y1": 9223,
    "global_x1": 76,
    "ocr_text": "I CAN'T\nSENSE ANY MANA\nFROM HIM AT ALL.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 56,
    "source_page": 15,
    "slice_index": 5,
    "object_id": "text_5967bf7e482145e1",
    "box_id": "box_5967bf7e482145e1",
    "global_y1": 11457,
    "global_x1": 357,
    "ocr_text": "HE'S\nNOT WORTH MY\nATTENTION.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 57,
    "source_page": 15,
    "slice_index": 6,
    "object_id": "text_1aa61677eb544b14",
    "box_id": "box_1aa61677eb544b14",
    "global_y1": 13247,
    "global_x1": 168,
    "ocr_text": "NOW, FOR OUR\nFIRST MATCH!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 57,
    "source_page": 15,
    "slice_index": 6,
    "object_id": "text_cd9a74d423d3475f",
    "box_id": "box_cd9a74d423d3475f",
    "global_y1": 15292,
    "global_x1": 113,
    "ocr_text": "INTRODUCING!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 58,
    "source_page": 16,
    "slice_index": 0,
    "object_id": "text_d641fb6daa444702",
    "box_id": "box_d641fb6daa444702",
    "global_y1": 293,
    "global_x1": 134,
    "ocr_text": "THE MARTIAL WORLD'S\nREPRESENTATIVE!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 58,
    "source_page": 16,
    "slice_index": 0,
    "object_id": "text_629f955eaab14897",
    "box_id": "box_629f955eaab14897",
    "global_y1": 2381,
    "global_x1": 136,
    "ocr_text": "HEAVENLY DEMON\nCHEON SOHYEOP!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 59,
    "source_page": 17,
    "slice_index": 0,
    "object_id": "text_c7137b4254eb4c0f",
    "box_id": "box_c7137b4254eb4c0f",
    "global_y1": 107,
    "global_x1": 188,
    "ocr_text": "AND HIS\nOPPONENT!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 59,
    "source_page": 17,
    "slice_index": 0,
    "object_id": "text_5e23826bef30450e",
    "box_id": "box_5e23826bef30450e",
    "global_y1": 1967,
    "global_x1": 97,
    "ocr_text": "THE ORDINARY\nWORLD'S REPRESENTATIVE,\nSHIN JAHYEON!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 60,
    "source_page": 17,
    "slice_index": 1,
    "object_id": "text_3faf2c3a9d2b4df7",
    "box_id": "box_3faf2c3a9d2b4df7",
    "global_y1": 2907,
    "global_x1": 137,
    "ocr_text": "<TOURNAMENT OF THE\nWORLDS' STRONGEST>\nTHE WORLD THAT\nLOSES A ONE-ON-ONE MATCH\nWILL BE DESTROYED.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 60,
    "source_page": 17,
    "slice_index": 1,
    "object_id": "text_938033bbf71740c9",
    "box_id": "box_938033bbf71740c9",
    "global_y1": 3422,
    "global_x1": 180,
    "ocr_text": "VICTORY CONDITIONS\nOPPONENT'S DEATH OR\nDECLARATION OF DEFEAT",
    "semantic_type": "text"
  },
  {
    "page_index": 64,
    "source_page": 17,
    "slice_index": 5,
    "object_id": "text_7d650a5906fc4213",
    "box_id": "box_7d650a5906fc4213",
    "global_y1": 13490,
    "global_x1": 71,
    "ocr_text": "THE BLUE CORNER\nNEEDS NO INTRODUCTION!!\nTHE MURIM ALLIANCE'S\nGREATEST NEMESIS!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 64,
    "source_page": 17,
    "slice_index": 5,
    "object_id": "text_80a42b49311d47c0",
    "box_id": "box_80a42b49311d47c0",
    "global_y1": 15601,
    "global_x1": 143,
    "ocr_text": "THE\nHEAVENLY DEMON!!\nCHEON SOHYEOP!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 66,
    "source_page": 19,
    "slice_index": 0,
    "object_id": "text_21cee06ce17f4220",
    "box_id": "box_21cee06ce17f4220",
    "global_y1": 0,
    "global_x1": 0,
    "ocr_text": "DRIVEN BY MY\nOWN AMBITION, I WALKED\nTHE PATH OF CONQUEST,",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 66,
    "source_page": 19,
    "slice_index": 0,
    "object_id": "text_88743aa6e64f47a2",
    "box_id": "box_88743aa6e64f47a2",
    "global_y1": 527,
    "global_x1": 33,
    "ocr_text": "AND AT ITS END,\nI TOOK THE MURIM\nFOR MYSELF.",
    "semantic_type": "text"
  },
  {
    "page_index": 66,
    "source_page": 19,
    "slice_index": 0,
    "object_id": "text_1fcf05ec34e3434b",
    "box_id": "box_1fcf05ec34e3434b",
    "global_y1": 3243,
    "global_x1": 1,
    "ocr_text": "IT IS A PATH\nI HAVE WALKED BEFORE.\nI ALREADY KNOW WHAT\nBLOOD STAINS IT.",
    "semantic_type": "text"
  },
  {
    "page_index": 67,
    "source_page": 19,
    "slice_index": 1,
    "object_id": "text_6c5d1f675e9d4a9c",
    "box_id": "box_6c5d1f675e9d4a9c",
    "global_y1": 4093,
    "global_x1": 0,
    "ocr_text": "THERE IS NO\nREASON TO HESITATE.",
    "semantic_type": "free_text"
  },
  {
    "page_index": 67,
    "source_page": 19,
    "slice_index": 1,
    "object_id": "text_e405d1c35e3842b0",
    "box_id": "box_e405d1c35e3842b0",
    "global_y1": 5020,
    "global_x1": 40,
    "ocr_text": "FOR THE SAKE\nOF MY FAMILY,",
    "semantic_type": "free_text"
  },
  {
    "page_index": 67,
    "source_page": 19,
    "slice_index": 1,
    "object_id": "text_manual_p067_conquest",
    "box_id": null,
    "global_y1": 5972,
    "global_x1": 50,
    "ocr_text": "I WOULD WALK THAT MERE\nPATH OF CONQUEST.",
    "semantic_type": "free_text"
  },
  {
    "page_index": 68,
    "source_page": 19,
    "slice_index": 2,
    "object_id": "text_manual_p068_hundred_times",
    "box_id": null,
    "global_y1": 8489,
    "global_x1": 70,
    "ocr_text": "...A HUNDRED\nMORE TIMES.",
    "semantic_type": "free_text"
  },
  {
    "page_index": 69,
    "source_page": 19,
    "slice_index": 3,
    "object_id": "text_933e933d97424ea9",
    "box_id": "box_933e933d97424ea9",
    "global_y1": 9559,
    "global_x1": 179,
    "ocr_text": "A HEAVENLY DEMON\nWHO HAS REACHED THE\nPROFOUND REALM!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 70,
    "source_page": 19,
    "slice_index": 4,
    "object_id": "text_5fd1dbd16fda4d0e",
    "box_id": "box_5fd1dbd16fda4d0e",
    "global_y1": 12946,
    "global_x1": 135,
    "ocr_text": "you\nSUMMONED ME FOR\nTHIS FARCE.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 70,
    "source_page": 19,
    "slice_index": 4,
    "object_id": "text_f00c1ea583ee4605",
    "box_id": "box_f00c1ea583ee4605",
    "global_y1": 15741,
    "global_x1": 141,
    "ocr_text": "PREPARE\nYOURSELVES.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 72,
    "source_page": 21,
    "slice_index": 0,
    "object_id": "text_05f0f3640ef3416f",
    "box_id": "box_05f0f3640ef3416f",
    "global_y1": 169,
    "global_x1": 136,
    "ocr_text": "I, THE HEAVENLY\nDEMON, WILL COME\nFOR YOUR HEADS.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 73,
    "source_page": 21,
    "slice_index": 1,
    "object_id": "text_7aecba7bc857451e",
    "box_id": "box_7aecba7bc857451e",
    "global_y1": 3356,
    "global_x1": 181,
    "ocr_text": "JUST AS\nI'D EXPECT... FROM\nMY CREATION.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 74,
    "source_page": 21,
    "slice_index": 2,
    "object_id": "text_64fbcd2df4b74e37",
    "box_id": "box_64fbcd2df4b74e37",
    "global_y1": 5803,
    "global_x1": 157,
    "ocr_text": "YOU MAKE\nYOUR MOTHER\nPROUD.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 75,
    "source_page": 21,
    "slice_index": 3,
    "object_id": "text_5ee02c92f7ed45a3",
    "box_id": "box_5ee02c92f7ed45a3",
    "global_y1": 8923,
    "global_x1": 125,
    "ocr_text": "OOOH!! AN\nOUTRIGHT CHALLENGE\nTO THE GODS!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 75,
    "source_page": 21,
    "slice_index": 3,
    "object_id": "text_2a91d34416b64e82",
    "box_id": "box_2a91d34416b64e82",
    "global_y1": 10634,
    "global_x1": 157,
    "ocr_text": "I LOVE THAT\nBOLDNESS!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 76,
    "source_page": 21,
    "slice_index": 4,
    "object_id": "text_ac11bc24039d4ce6",
    "box_id": "box_ac11bc24039d4ce6",
    "global_y1": 11595,
    "global_x1": 167,
    "ocr_text": "NEXT, IN THE\nRED CORNER!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 76,
    "source_page": 21,
    "slice_index": 4,
    "object_id": "text_8fc2f3f6c6214727",
    "box_id": "box_8fc2f3f6c6214727",
    "global_y1": 13452,
    "global_x1": 132,
    "ocr_text": "THE\nPRIDE OF MODERN\nHUMANITY!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 77,
    "source_page": 21,
    "slice_index": 5,
    "object_id": "text_4c9c26a085c34d1e",
    "box_id": "box_4c9c26a085c34d1e",
    "global_y1": 14485,
    "global_x1": 52,
    "ocr_text": "AN UNEMPLOYED\nSHUT-IN GAMER OF\nMANY YEARS...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 77,
    "source_page": 21,
    "slice_index": 5,
    "object_id": "text_c25c91fc791b4f75",
    "box_id": "box_c25c91fc791b4f75",
    "global_y1": 15889,
    "global_x1": 540,
    "ocr_text": "UH...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 78,
    "source_page": 22,
    "slice_index": 0,
    "object_id": "text_e5a225f187fd49d0",
    "box_id": "box_e5a225f187fd49d0",
    "global_y1": 751,
    "global_x1": 217,
    "ocr_text": "IS THIS...\nCORRECT?",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 80,
    "source_page": 23,
    "slice_index": 1,
    "object_id": "text_127e8747f3ff48a4",
    "box_id": "box_127e8747f3ff48a4",
    "global_y1": 1811,
    "global_x1": 86,
    "ocr_text": "THERE GOES\nALL THE EXCITEMENT\nTHAT WAS BUILT UP.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 80,
    "source_page": 23,
    "slice_index": 1,
    "object_id": "text_e6b0a802102a4293",
    "box_id": "box_e6b0a802102a4293",
    "global_y1": 3901,
    "global_x1": 106,
    "ocr_text": "PUTTING SUCH A\nPATHETIC WRETCH ON\nA STAGE LIKE THIS,",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 81,
    "source_page": 23,
    "slice_index": 2,
    "object_id": "text_d0d56ae85fbb4091",
    "box_id": "box_d0d56ae85fbb4091",
    "global_y1": 4948,
    "global_x1": 64,
    "ocr_text": "JUST WHAT\nYOU'D EXPECT FROM\nTHE ORDINARY\nWORLD...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 81,
    "source_page": 23,
    "slice_index": 2,
    "object_id": "text_797d52033b214867",
    "box_id": "box_797d52033b214867",
    "global_y1": 6473,
    "global_x1": 374,
    "ocr_text": "THE NERVE\nOF THEM TO ENTER\nTHE TOURNAMENT\nOF THE WORLDS'\nSTRONGEST.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 81,
    "source_page": 23,
    "slice_index": 2,
    "object_id": "text_6f19ae8c374b41b0",
    "box_id": "box_6f19ae8c374b41b0",
    "global_y1": 6957,
    "global_x1": 96,
    "ocr_text": "THIS MATCH\nIS GOING TO BE\nBORING.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 82,
    "source_page": 23,
    "slice_index": 3,
    "object_id": "text_c789a27bd73847a5",
    "box_id": "box_c789a27bd73847a5",
    "global_y1": 7887,
    "global_x1": 78,
    "ocr_text": "THAT\nPOOR HUMAN.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 82,
    "source_page": 23,
    "slice_index": 3,
    "object_id": "text_fd3a3abf1e5e4e82",
    "box_id": "box_fd3a3abf1e5e4e82",
    "global_y1": 9366,
    "global_x1": 337,
    "ocr_text": "THAT GUY\nWILL KILL HIM\nWITH EASE.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 82,
    "source_page": 23,
    "slice_index": 3,
    "object_id": "text_0d3cf8c036114e7e",
    "box_id": "box_0d3cf8c036114e7e",
    "global_y1": 9861,
    "global_x1": 83,
    "ocr_text": "WELL, WHAT\nCAN YOU DO?",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 83,
    "source_page": 23,
    "slice_index": 4,
    "object_id": "text_493b35f93feb4aa9",
    "box_id": "box_493b35f93feb4aa9",
    "global_y1": 10763,
    "global_x1": 154,
    "ocr_text": "HE\nHAS ONLY HIMSELF\nTO BLAME FOR HAVING\nSUCH A WORTHLESS\nCREATOR.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 84,
    "source_page": 23,
    "slice_index": 5,
    "object_id": "text_0d2297aae21649b4",
    "box_id": "box_0d2297aae21649b4",
    "global_y1": 14497,
    "global_x1": 142,
    "ocr_text": "HURRY UP\nAND START. THE\nOUTCOME IS OBVIOUS\nANYWAY.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 85,
    "source_page": 24,
    "slice_index": 0,
    "object_id": "text_545aa4048a494db7",
    "box_id": "box_545aa4048a494db7",
    "global_y1": 992,
    "global_x1": 127,
    "ocr_text": "...F-",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 85,
    "source_page": 24,
    "slice_index": 0,
    "object_id": "text_7c38ecd9830e496f",
    "box_id": "box_7c38ecd9830e496f",
    "global_y1": 2344,
    "global_x1": 104,
    "ocr_text": "FIGHT!!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 86,
    "source_page": 25,
    "slice_index": 0,
    "object_id": "text_fc2019f421784cd5",
    "box_id": "box_fc2019f421784cd5",
    "global_y1": 2095,
    "global_x1": 98,
    "ocr_text": "HEAVENLY DEMON'S\nHEAVEN-OPENING FORM",
    "semantic_type": "text"
  },
  {
    "page_index": 88,
    "source_page": 25,
    "slice_index": 2,
    "object_id": "text_c291bdc565eb4954",
    "box_id": "box_c291bdc565eb4954",
    "global_y1": 6395,
    "global_x1": 243,
    "ocr_text": "HEAVENLY DEMON'S\nGOD-SLAYING SLASH",
    "semantic_type": "text"
  },
  {
    "page_index": 90,
    "source_page": 25,
    "slice_index": 4,
    "object_id": "text_25d31762d4ac4eb9",
    "box_id": "box_25d31762d4ac4eb9",
    "global_y1": 12896,
    "global_x1": 51,
    "ocr_text": "THE STANDS,\nCUT IN TWO WITH A\nSINGLE STROKE!! WHAT\nAN EXPLOSIVE START!",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 94,
    "source_page": 26,
    "slice_index": 3,
    "object_id": "text_7085ab81c7c84ed2",
    "box_id": "box_7085ab81c7c84ed2",
    "global_y1": 11583,
    "global_x1": 358,
    "ocr_text": "HE'S\nMORE AGILE THAN\nHE LOOKS.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 95,
    "source_page": 26,
    "slice_index": 4,
    "object_id": "text_f3fcdf2816754cad",
    "box_id": "box_f3fcdf2816754cad",
    "global_y1": 13396,
    "global_x1": 218,
    "ocr_text": "THAT'S\nALL HE HAS.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 95,
    "source_page": 26,
    "slice_index": 4,
    "object_id": "text_69b9b06e733b4efa",
    "box_id": "box_69b9b06e733b4efa",
    "global_y1": 15387,
    "global_x1": 147,
    "ocr_text": "IN THE END, HE'S\nJUST AN ORDINARY\nHUMAN.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 102,
    "source_page": 28,
    "slice_index": 5,
    "object_id": "text_manual_p102_footwork",
    "box_id": null,
    "global_y1": 15157,
    "global_x1": 50,
    "ocr_text": "HEAVENLY\nDEMONIC FOOTWORK",
    "semantic_type": "skill_name"
  },
  {
    "page_index": 103,
    "source_page": 29,
    "slice_index": 0,
    "object_id": "text_e26baccf78af4e33",
    "box_id": "box_e26baccf78af4e33",
    "global_y1": 1818,
    "global_x1": 0,
    "ocr_text": "HEAVEN-REACHING\nSHADOWLESS STEP",
    "semantic_type": "text"
  },
  {
    "page_index": 108,
    "source_page": 29,
    "slice_index": 5,
    "object_id": "text_b8a5dacc6c2d412e",
    "box_id": "box_b8a5dacc6c2d412e",
    "global_y1": 13393,
    "global_x1": 364,
    "ocr_text": "IT'S AN\nEXPECTED RESULT,\nI SUPPOSE...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 108,
    "source_page": 29,
    "slice_index": 5,
    "object_id": "text_cda41d47c0b44d87",
    "box_id": "box_cda41d47c0b44d87",
    "global_y1": 15078,
    "global_x1": 356,
    "ocr_text": "THIS MUST\nBE THE ORDINARY\nWORLD'S LIMIT.",
    "semantic_type": "text"
  },
  {
    "page_index": 109,
    "source_page": 30,
    "slice_index": 0,
    "object_id": "text_3b6fbccda909456b",
    "box_id": "box_3b6fbccda909456b",
    "global_y1": 11,
    "global_x1": 49,
    "ocr_text": "IT IS THE\nWEAKEST OF ALL\nOUR WORLDS,\nAFTER ALL.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 110,
    "source_page": 31,
    "slice_index": 0,
    "object_id": "text_1205209161b545ef",
    "box_id": "box_1205209161b545ef",
    "global_y1": 194,
    "global_x1": 274,
    "ocr_text": "BLAME MY\nINCOMPETENCE.",
    "semantic_type": "free_text"
  },
  {
    "page_index": 111,
    "source_page": 31,
    "slice_index": 1,
    "object_id": "text_37f29f0ed34647fa",
    "box_id": "box_37f29f0ed34647fa",
    "global_y1": 2520,
    "global_x1": 182,
    "ocr_text": "TO BE\nHONEST... THE\nHUMANITY I CREATED\nHAS NO CHANCE OF\nWINNING.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 111,
    "source_page": 31,
    "slice_index": 1,
    "object_id": "text_04baf38eca0a47c9",
    "box_id": "box_04baf38eca0a47c9",
    "global_y1": 4357,
    "global_x1": 397,
    "ocr_text": "AT THIS RATE...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 112,
    "source_page": 31,
    "slice_index": 2,
    "object_id": "text_16cecc9cda554e12",
    "box_id": "box_16cecc9cda554e12",
    "global_y1": 5272,
    "global_x1": 210,
    "ocr_text": "YOUR ENTIRE\nHUMAN RACE WILL\nPERISH.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 113,
    "source_page": 31,
    "slice_index": 3,
    "object_id": "text_1ce939b49d8548d6",
    "box_id": "box_1ce939b49d8548d6",
    "global_y1": 7765,
    "global_x1": 82,
    "ocr_text": "YOU MUST\nHAVE CALLED ME\nHERE BECAUSE YOU\nHAVE A SOLUTION.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 113,
    "source_page": 31,
    "slice_index": 3,
    "object_id": "text_f9d538e9c3a34ebc",
    "box_id": "box_f9d538e9c3a34ebc",
    "global_y1": 8990,
    "global_x1": 394,
    "ocr_text": "PLEASE\nGET TO THE\nPOINT.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 113,
    "source_page": 31,
    "slice_index": 3,
    "object_id": "text_5e3872accfe1407d",
    "box_id": "box_5e3872accfe1407d",
    "global_y1": 9495,
    "global_x1": 101,
    "ocr_text": "YES.\nYOU'RE RIGHT.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 114,
    "source_page": 31,
    "slice_index": 4,
    "object_id": "text_e79ff2680a464a65",
    "box_id": "box_e79ff2680a464a65",
    "global_y1": 10388,
    "global_x1": 226,
    "ocr_text": "I HAVE\nAN IDEA.",
    "semantic_type": "text"
  },
  {
    "page_index": 115,
    "source_page": 31,
    "slice_index": 5,
    "object_id": "text_ef5ce3f18c764743",
    "box_id": "box_ef5ce3f18c764743",
    "global_y1": 12745,
    "global_x1": 30,
    "ocr_text": "A CONTEST WHERE A\nREPRESENTATIVE \"CREATION\"\nFROM EVERY WORLD COMPETES\nFOR SUPREMACY...",
    "semantic_type": "free_text"
  },
  {
    "page_index": 115,
    "source_page": 31,
    "slice_index": 5,
    "object_id": "text_9bd27f1988274aa2",
    "box_id": "box_9bd27f1988274aa2",
    "global_y1": 14998,
    "global_x1": 35,
    "ocr_text": "THE TOURNAMENT\nOF THE WORLDS'\nSTRONGEST.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 115,
    "source_page": 31,
    "slice_index": 5,
    "object_id": "text_9a6cedb1b0434ff3",
    "box_id": "box_9a6cedb1b0434ff3",
    "global_y1": 15767,
    "global_x1": 93,
    "ocr_text": "WHAT IF THE\nDEFINITION OF A\n\"CREATION\"...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 116,
    "source_page": 32,
    "slice_index": 0,
    "object_id": "text_cb75688b866446ef",
    "box_id": "box_cb75688b866446ef",
    "global_y1": 1109,
    "global_x1": 102,
    "ocr_text": "EXTENDED\nBEYOND THE\nHUMANS I'VE\nCREATED...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 116,
    "source_page": 32,
    "slice_index": 0,
    "object_id": "text_32cd22e922bb492e",
    "box_id": "box_32cd22e922bb492e",
    "global_y1": 1525,
    "global_x1": 233,
    "ocr_text": "TO THE\n\"CREATIONS\" HUMANS\nHAVE MADE?",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 117,
    "source_page": 33,
    "slice_index": 0,
    "object_id": "text_87faa953a5ec45bc",
    "box_id": "box_87faa953a5ec45bc",
    "global_y1": 214,
    "global_x1": 111,
    "ocr_text": "WOULDN'T\nTHOSE ALSO BE MY\n\"CREATIONS\"?",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 118,
    "source_page": 33,
    "slice_index": 1,
    "object_id": "text_febe29e6dfd647b5",
    "box_id": "box_febe29e6dfd647b5",
    "global_y1": 2938,
    "global_x1": 196,
    "ocr_text": "I DID NOT\nSUMMON THE\nHUMAN SHIN\nJAHYEON.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 119,
    "source_page": 33,
    "slice_index": 2,
    "object_id": "text_4d6ef1c119584300",
    "box_id": "box_4d6ef1c119584300",
    "global_y1": 4960,
    "global_x1": 174,
    "ocr_text": "I WILL\nSUMMON THE\nVIRTUAL WORLD\nYOU HUMANS\nCREATED.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 120,
    "source_page": 33,
    "slice_index": 3,
    "object_id": "text_abff2b4ca78c4f0c",
    "box_id": "box_abff2b4ca78c4f0c",
    "global_y1": 7025,
    "global_x1": 138,
    "ocr_text": "YOU'LL SUMMON\nMY CHARACTER FROM\nA GAME.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 121,
    "source_page": 33,
    "slice_index": 4,
    "object_id": "text_f62ebb5b84d94089",
    "box_id": "box_f62ebb5b84d94089",
    "global_y1": 10079,
    "global_x1": 10,
    "ocr_text": "A CREATION BORN\nOF HUMAN HANDS.",
    "semantic_type": "text"
  },
  {
    "page_index": 122,
    "source_page": 33,
    "slice_index": 5,
    "object_id": "text_0409eadecfd44070",
    "box_id": "box_0409eadecfd44070",
    "global_y1": 12542,
    "global_x1": 118,
    "ocr_text": "A CHARACTER.",
    "semantic_type": "text"
  },
  {
    "page_index": 123,
    "source_page": 34,
    "slice_index": 0,
    "object_id": "text_37324dad6c604b78",
    "box_id": "box_37324dad6c604b78",
    "global_y1": 854,
    "global_x1": 173,
    "ocr_text": "A CHARACTER\nHAS NO PHYSICAL\nBODY.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 124,
    "source_page": 35,
    "slice_index": 0,
    "object_id": "text_564c21f02ec3444b",
    "box_id": "box_564c21f02ec3444b",
    "global_y1": 184,
    "global_x1": 55,
    "ocr_text": "IT SEEMS THAT'S\nWHY YOU, THE PLAYER,\nSHIN JAHYEON, WERE\nSUMMONED.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 124,
    "source_page": 35,
    "slice_index": 0,
    "object_id": "text_50d9f415eb3141b9",
    "box_id": "box_50d9f415eb3141b9",
    "global_y1": 2147,
    "global_x1": 331,
    "ocr_text": "BUT\nI CAN CLEARLY\nSENSE IT.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 125,
    "source_page": 35,
    "slice_index": 1,
    "object_id": "text_e8930ad3d2ed4e8a",
    "box_id": "box_e8930ad3d2ed4e8a",
    "global_y1": 3137,
    "global_x1": 62,
    "ocr_text": "WITHIN\nYOUR BODY, SHIN\nJAHYEON...",
    "semantic_type": "text"
  },
  {
    "page_index": 125,
    "source_page": 35,
    "slice_index": 1,
    "object_id": "text_625817daf752448f",
    "box_id": "box_625817daf752448f",
    "global_y1": 3522,
    "global_x1": 80,
    "ocr_text": "LV.120\nSHIN JAHYEON",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 126,
    "source_page": 35,
    "slice_index": 2,
    "object_id": "text_c33c8c03889c4e98",
    "box_id": "box_c33c8c03889c4e98",
    "global_y1": 4961,
    "global_x1": 126,
    "ocr_text": "THE\nPRESENCE OF YOUR\nCHARACTER.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 126,
    "source_page": 35,
    "slice_index": 2,
    "object_id": "text_c00f9f4c471a40ac",
    "box_id": "box_c00f9f4c471a40ac",
    "global_y1": 6879,
    "global_x1": 64,
    "ocr_text": "LV.120\nSHIN JAHYEON",
    "semantic_type": "free_text"
  },
  {
    "page_index": 127,
    "source_page": 35,
    "slice_index": 3,
    "object_id": "text_b411bc37503949ea",
    "box_id": "box_b411bc37503949ea",
    "global_y1": 9452,
    "global_x1": 0,
    "ocr_text": "INDEED.\nA \"CREATION\" MADE\nBY HUMAN HANDS, ONCE\nNOTHING MORE\nTHAN DATA...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 128,
    "source_page": 35,
    "slice_index": 4,
    "object_id": "text_ac31f2d214594ef5",
    "box_id": "box_ac31f2d214594ef5",
    "global_y1": 10740,
    "global_x1": 31,
    "ocr_text": "YOUR FAMILIAR\nFULLY RESTORES ITS\nMASTER!",
    "semantic_type": "text"
  },
  {
    "page_index": 129,
    "source_page": 35,
    "slice_index": 5,
    "object_id": "text_a0b98deebac14333",
    "box_id": "box_a0b98deebac14333",
    "global_y1": 12604,
    "global_x1": 0,
    "ocr_text": "...THIS VERY\nTOURNAMENT!",
    "semantic_type": "free_text"
  },
  {
    "page_index": 130,
    "source_page": 36,
    "slice_index": 0,
    "object_id": "text_c87d29ebfe2e4a15",
    "box_id": "box_c87d29ebfe2e4a15",
    "global_y1": 728,
    "global_x1": 175,
    "ocr_text": "REVEAL\nYOUR TRUE FORM,\nNEFER.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 132,
    "source_page": 37,
    "slice_index": 1,
    "object_id": "text_032863d770744536",
    "box_id": "box_032863d770744536",
    "global_y1": 1864,
    "global_x1": 154,
    "ocr_text": "YES.\nMASTER",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 133,
    "source_page": 37,
    "slice_index": 2,
    "object_id": "text_4dfd22e0864c4b8b",
    "box_id": "box_4dfd22e0864c4b8b",
    "global_y1": 6335,
    "global_x1": 344,
    "ocr_text": "OUR GOD'S\nPRETTY CLEVER.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 133,
    "source_page": 37,
    "slice_index": 2,
    "object_id": "text_d53ad2dcf3af45ae",
    "box_id": "box_d53ad2dcf3af45ae",
    "global_y1": 8279,
    "global_x1": 67,
    "ocr_text": "IMPLANTING\nINTANGIBLE DATA\nINTO MY BODY...",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 133,
    "source_page": 37,
    "slice_index": 2,
    "object_id": "text_e0349f23484b4e73",
    "box_id": "box_e0349f23484b4e73",
    "global_y1": 8709,
    "global_x1": 279,
    "ocr_text": "SO THE\nPLAYER AND THE\nCHARACTER ARE ONE\nAND THE SAME?",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 134,
    "source_page": 37,
    "slice_index": 3,
    "object_id": "text_ebae8806bdde4e29",
    "box_id": "box_ebae8806bdde4e29",
    "global_y1": 11139,
    "global_x1": 419,
    "ocr_text": "NEFER.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 136,
    "source_page": 37,
    "slice_index": 5,
    "object_id": "text_a8c24e13d4504fc4",
    "box_id": "box_a8c24e13d4504fc4",
    "global_y1": 13164,
    "global_x1": 141,
    "ocr_text": "BUFF ME...\nWITH EVERYTHING\nYOU'VE GOT.",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 137,
    "source_page": 38,
    "slice_index": 0,
    "object_id": "text_362e954e060a48b3",
    "box_id": "box_362e954e060a48b3",
    "global_y1": 646,
    "global_x1": 145,
    "ocr_text": "DUNGEON &\nWEAPON ONLINE",
    "semantic_type": "speech_bubble"
  },
  {
    "page_index": 137,
    "source_page": 38,
    "slice_index": 0,
    "object_id": "text_62e76a34a9c14eb2",
    "box_id": "box_62e76a34a9c14eb2",
    "global_y1": 991,
    "global_x1": 130,
    "ocr_text": "CLASS: WARLOCK\nSHIN JAHYEON",
    "semantic_type": "text"
  },
  {
    "page_index": 137,
    "source_page": 38,
    "slice_index": 0,
    "object_id": "text_ef46039d99f84f19",
    "box_id": "box_ef46039d99f84f19",
    "global_y1": 1484,
    "global_x1": 97,
    "ocr_text": "ALL-SERVER\nRANKING",
    "semantic_type": "free_text"
  },
  {
    "page_index": 137,
    "source_page": 38,
    "slice_index": 0,
    "object_id": "text_manual_p137_rank",
