{
  "manifest_version": 3,
  "name": "Manga Translator: gửi chương",
  "version": "1.0",
  "description": "Gửi ảnh truyện trên trang đang mở vào Manga Translator trên máy này.",
  "icons": { "128": "icon128.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon128.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "declarativeNetRequestWithHostAccess"],
  "host_permissions": ["<all_urls>"]
}
