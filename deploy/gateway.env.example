# Copy to gateway.env (git ignores it) and fill in. Never commit real keys.

# A.I upstream the gateway pays for (OpenAI-compatible chat completions).
GATEWAY_UPSTREAM_BASE=https://api.minirouter.sh/v1
GATEWAY_UPSTREAM_KEY=
GATEWAY_UPSTREAM_MODEL=openai/gpt-6-luna
GATEWAY_PRICE_INPUT_PER_M=0.105
GATEWAY_PRICE_OUTPUT_PER_M=0.525
GATEWAY_PRICE_CACHED_PER_M=0.0105
# GATEWAY_UPSTREAM_REASONING_EFFORT=low
# Azure OpenAI (startup credits): base https://<resource>.openai.azure.com/openai/v1, the model is the
# deployment name, and newer models take max_completion_tokens.
# GATEWAY_UPSTREAM_AUTH=api-key
# GATEWAY_UPSTREAM_MAX_TOKENS_FIELD=max_completion_tokens
# Models per A.I mode checkpoint (scan, glossary, review, translate), each list in fallback order: the next
# model answers at once when one is overloaded. Every model must read images. Unlisted checkpoints use the model above.
# "effort" (none, minimal, low, medium, high) fixes a model's thinking level whatever the request asks.
GATEWAY_STAGE_MODELS=[{"stage":"scan","model":"meta/muse-spark-1.2-contributor","price":[0.105,0.21,0.0021],"effort":"none"},{"stage":"scan","model":"openai/gpt-6-luna","price":[0.105,0.525,0.0105]},{"stage":"review","model":"meta/muse-spark-1.2-contributor","price":[0.105,0.21,0.0021],"effort":"none"},{"stage":"review","model":"openai/gpt-6-luna","price":[0.105,0.525,0.0105]},{"stage":"glossary","model":"meta/muse-spark-1.2-contributor","price":[0.105,0.21,0.0021],"effort":"none"},{"stage":"glossary","model":"openai/gpt-6-luna","price":[0.105,0.525,0.0105]},{"stage":"translate","model":"openai/gpt-6-luna","price":[0.105,0.525,0.0105]},{"stage":"translate","model":"xiaomi/mimo-v2.6-flash","price":[0.147,0.294,0.00294]}]
# Fallbacks for the model above, same format without "stage".
# GATEWAY_FALLBACK_MODELS=

# What users pay on top of the A.I cost, in percent.
GATEWAY_FEE_PERCENT=5
GATEWAY_VND_PER_USD=26000

# Admin API key: long and random, e.g. `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
GATEWAY_ADMIN_KEY=

# Login codes by email (Resend). Leave GATEWAY_DEV_LOGIN unset in production.
GATEWAY_RESEND_API_KEY=
GATEWAY_MAIL_FROM=Manga Translator <login@your-domain.example>

# Where payment pages send the user back (the app's address as the user opens it).
GATEWAY_RETURN_URL=http://127.0.0.1:8000

# payOS (VietQR). Webhook URL: https://<GATEWAY_DOMAIN>/v1/billing/payos/webhook
GATEWAY_PAYOS_CLIENT_ID=
GATEWAY_PAYOS_API_KEY=
GATEWAY_PAYOS_CHECKSUM_KEY=
# payOS fee in percent, added to what the user pays (0 on the free tier).
GATEWAY_PAYOS_FEE_PERCENT=0

# Lemon Squeezy (cards). Webhook URL: https://<GATEWAY_DOMAIN>/v1/billing/lemonsqueezy/webhook
GATEWAY_LS_API_KEY=
GATEWAY_LS_STORE_ID=
# One variant of a "credit" product; each checkout sets its own price.
GATEWAY_LS_VARIANT=
GATEWAY_LS_WEBHOOK_SECRET=
# Lemon Squeezy's fee, added to what the user pays.
GATEWAY_LS_FEE_PERCENT=5
GATEWAY_LS_FEE_FIXED_USD=0.50
