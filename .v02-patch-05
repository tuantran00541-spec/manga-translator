     @staticmethod
     def _box_in_excluded(box, excluded_regions: list[dict]) -> bool:
         box_cx = (box.x1 + box.x2) / 2
         box_cy = (box.y1 + box.y2) / 2
         for r in excluded_regions:
             x1 = r.get("x1", 0)
             y1 = r.get("y1", 0)
             x2 = r.get("x2", 0)
             y2 = r.get("y2", 0)
             if min(x1, x2) <= box_cx <= max(x1, x2) and min(y1, y2) <= box_cy <= max(y1, y2):
                 return True
         return False
