ư Peph’Ra, như mọi người thấy đấy.", "role": "dialogue", "container": "bubble", "font": "dialogue.mac-dinh-3", "seam_owner": null, "overlap_dropped": null, "source_missing": null}, {"id": "text_1fb6c092236d4c80", "region": {"x1": 710, "y1": 629, "x2": 957, "y2": 828}, "source_boxes": ["box_1fb6c092236d4c80"], "translation": "Ít ra ở đây, tôi được cần đến và trân trọng tài năng!", "role": "dialogue", "container": "bubble", "font": "dialogue.mac-dinh-3", "seam_owner": null, "overlap_dropped": null, "source_missing": null}, {"id": "text_3776f93edf1c4686", "region": {"x1": 43, "y1": 645, "x2": 258, "y2": 773}, "source_boxes": ["box_3776f93edf1c4686"], "translation": "“Nhưng tại sao,” bạn có thể hỏi?!", "role": "dialogue", "container": "bubble", "font": "dialogue.mac-dinh-3", "seam_owner": null, "overlap_dropped": null, "source_missing": null}, {"id": "text_f08b5aab80e64124", "region": {"x1": 488, "y1": 691, "x2": 699, "y2": 886}, "source_boxes": ["box_f08b5aab80e64124"], "translation": "Đơn giản thôi! Tôi chịu hết nổi rồi!", "role": "shout", "container": "spiky", "font": "emphasis.bangers", "seam_owner": null, "overlap_dropped": null, "source_missing": null}, {"id": "text_aedebc0495e646a4", "region": {"x1": 991, "y1": 485, "x2": 1095, "y2": 570}, "source_boxes": ["box_aedebc0495e646a4"], "translation": "...", "role": "dialogue", "container": "bubble", "font": "dialogue.mac-dinh-3", "seam_owner": null, "overlap_dropped": null, "source_missing": null}], "preserve_regions": []}, {"slice": 6, "skipped": false, "stitch_core": {"source_y1": 0, "source_y2": 1660, "core_y1": 0, "core_y2": 1660, "core_source_y1": 0, "core_source_y2": 1660, "unsafe_before": false, "unsafe_after": false, "source_height": 1660}, "boxes": [{"x1": 468, "y1": 629, "x2": 899, "y2": 959, "origin": "detector", "manual": false, "overlap_context_only": false, "removed": false}, {"x1": 28, "y1": 1000, "x2": 265, "y2": 1222, "origin": "detector", "manual": false, "overlap_context_only": false, "removed": fal